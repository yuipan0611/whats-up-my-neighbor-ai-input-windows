<Window x:Class="NekoChat.Windows.ChatWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NekoChat.Windows"
 Title="Neko Chat Lite" Icon="Assets/app.ico" Width="1100" Height="740" MinWidth="440" MinHeight="360" Background="White" Foreground="#1C2C41"
 FontFamily="Microsoft JhengHei UI, Microsoft JhengHei" FontSize="13" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="10,5"/>
   <Setter Property="MinHeight" Value="28"/>
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#DCE3EC"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Foreground" Value="#1C2C41"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="#F3F6FA"/><Setter TargetName="border" Property="BorderBrush" Value="#2859C5"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="border" Property="Background" Value="#E9EFFD"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="border" Property="Opacity" Value="0.5"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button">
   <Setter Property="Padding" Value="18,8"/>
   <Setter Property="MinHeight" Value="38"/>
   <Setter Property="Background" Value="#2859C5"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="#1E429F"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="border" Property="Background" Value="#1A367E"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="border" Property="Opacity" Value="0.5"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Padding" Value="10,3"/>
   <Setter Property="MinHeight" Value="24"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="#F3F6FA"/><Setter TargetName="border" Property="BorderBrush" Value="#2859C5"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="border" Property="Background" Value="#E9EFFD"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="border" Property="Opacity" Value="0.5"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="CircleIconButton" TargetType="Button">
   <Setter Property="Background" Value="#EDF2F8"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Width" Value="28"/>
   <Setter Property="Height" Value="28"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="14" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" SnapsToDevicePixels="True">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="#DCE3EC"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="border" Property="Background" Value="#CBD5E1"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="CompactComboBox" TargetType="ComboBox">
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#DCE3EC"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Foreground" Value="#1C2C41"/>
   <Setter Property="SnapsToDevicePixels" Value="True"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBox">
      <Grid>
       <ToggleButton x:Name="ToggleButton" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
        <ToggleButton.Template>
         <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="border" Background="White" BorderBrush="#DCE3EC" BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
           <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
            <Path x:Name="arrow" Grid.Column="1" Data="M0 0 L4 4 L8 0" Stroke="#596B80" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
           </Grid>
          </Border>
          <ControlTemplate.Triggers>
           <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="#2859C5"/><Setter TargetName="border" Property="Background" Value="#F3F6FA"/></Trigger>
           <Trigger Property="IsChecked" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="#2859C5"/></Trigger>
          </ControlTemplate.Triggers>
         </ControlTemplate>
        </ToggleButton.Template>
       </ToggleButton>
       <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="8,0,24,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
       <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
        <Border x:Name="DropDownBorder" Background="White" BorderBrush="#DCE3EC" BorderThickness="1" CornerRadius="6" Margin="0,2,0,0" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True">
         <ScrollViewer Margin="2" SnapsToDevicePixels="True">
          <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
         </ScrollViewer>
        </Border>
       </Popup>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="HasItems" Value="false"><Setter TargetName="DropDownBorder" Property="MinHeight" Value="95"/></Trigger>
       <Trigger Property="IsEnabled" Value="false"><Setter Property="Opacity" Value="0.5"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="CompactComboBoxItem" TargetType="ComboBoxItem">
   <Setter Property="Padding" Value="8,4"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="Border" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="4" Margin="2,1" SnapsToDevicePixels="True">
       <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Border" Property="Background" Value="#EDF2F8"/><Setter Property="Foreground" Value="#2859C5"/></Trigger>
       <Trigger Property="IsSelected" Value="True"><Setter TargetName="Border" Property="Background" Value="#E9EFFD"/><Setter Property="Foreground" Value="#2859C5"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="8,5"/>
   <Setter Property="BorderBrush" Value="#DCE3EC"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Background" Value="White"/>
   <Setter Property="Foreground" Value="#1C2C41"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TextBox">
      <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
       <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Padding="{TemplateBinding Padding}"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="#2859C5"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="InboxItem" TargetType="ListBoxItem">
   <Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="RowBackground" Background="{TemplateBinding Background}" Padding="16,8"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBackground" Property="Background" Value="#EDF2F8"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="RowBackground" Property="Background" Value="#E9EFFD"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="RowBackground" Property="BorderBrush" Value="#2859C5"/><Setter TargetName="RowBackground" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="Shell" SizeChanged="ShellSizeChanged">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="InboxColumn" Width="288"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="InboxPane" Grid.Column="0" BorderBrush="#DCE3EC" BorderThickness="0,0,1,0">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="16,16,16,8">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Image Source="Assets/original.png" Width="36" Height="36" Margin="0,0,8,0"/><TextBlock Text="Neko Chat Lite" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/></StackPanel>
      <Border Background="#E9EFFD" CornerRadius="8" Padding="12,8"><TextBlock Text="Inbox" Foreground="#2859C5" FontWeight="Bold"/></Border>
      <TextBlock Text="教材功能保留" Foreground="#596B80" Margin="12,8,0,16"/>
      <TextBlock x:Name="InboxCount" Text="同學 · 載入中…" Foreground="#596B80" FontSize="12" Margin="0,0,0,4"/>
      <TextBox x:Name="InboxSearch" TextChanged="InboxSearchChanged" AutomationProperties.Name="搜尋姓名、學號、完整 IP 或 IP 尾碼" ToolTip="姓名、學號、完整 IP 或 IP 尾碼" Margin="0,0,0,8"/>
      <ComboBox x:Name="InboxFilter" SelectedIndex="0" SelectionChanged="InboxFilterChanged" AutomationProperties.Name="名單篩選"><ComboBoxItem Content="全部"/><ComboBoxItem Content="未讀"/></ComboBox>
     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="16,12">
      <WrapPanel VerticalAlignment="Center">
       <Button Content="新增同學" Click="AddRosterClick" Height="30" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,8,8"/>
       <Button Content="匯入 CSV" Click="ImportRosterClick" Height="30" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,8,8"/>
       <Button Content="設定" Click="OpenSettingsClick" Height="30" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
      </WrapPanel>
      <TextBlock x:Name="IdentityStatus" Text="教室區域網路・依名單 IP" Foreground="#596B80" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
     </StackPanel>
     <Grid><ListBox x:Name="InboxList" BorderThickness="0" SelectionChanged="InboxSelectionChanged" ItemContainerStyle="{StaticResource InboxItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
      <ListBox.ItemTemplate><DataTemplate><Grid AutomationProperties.Name="{Binding AccessibleLabel}"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Grid Width="36" Height="36" VerticalAlignment="Top" Margin="0,2,0,0"><Image Source="{Binding Avatar}" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/><Ellipse Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{Binding DotFill}" Stroke="{Binding DotStroke}" StrokeThickness="2" StrokeDashArray="{Binding DotDash}"/></Grid>
       <StackPanel Grid.Column="1" Margin="8,0,4,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Student}" Foreground="#596B80" FontSize="12"/><TextBlock Text="{Binding State}" Foreground="#596B80" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="{Binding Draft}" Foreground="#916015" FontSize="12"/></StackPanel>
       <Border Grid.Column="2" Background="#2859C5" CornerRadius="10" VerticalAlignment="Top" Padding="6,0" Visibility="{Binding BadgeVisibility}"><TextBlock Text="{Binding Badge}" Foreground="White" FontSize="12"/></Border>
      </Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox><StackPanel x:Name="InboxEmptyPanel" Margin="16" Visibility="Collapsed"><TextBlock x:Name="InboxEmpty" Text="尚無同學，可手動新增或匯入 CSV。" TextWrapping="Wrap" Foreground="#596B80" Margin="0,0,0,12"/><Button x:Name="AddFirstContactButton" Style="{StaticResource PrimaryButton}" Content="＋ 點此新增第一個聊天對象" Click="AddRosterClick" HorizontalAlignment="Left"/></StackPanel></Grid>
    </DockPanel>
   </Border>
   <Grid x:Name="ConversationPane" Grid.Column="1" AllowDrop="True" PreviewDragOver="ComposerDragOver" PreviewDragLeave="ComposerDragLeave" PreviewDrop="ComposerDrop">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border BorderBrush="#DCE3EC" BorderThickness="0,0,0,1" Padding="16,12"><DockPanel>
     <Button x:Name="BackToInbox" Content="← 返回名單" Click="BackToInboxClick" DockPanel.Dock="Left" Margin="0,0,12,0" Visibility="Collapsed"/>
     <Button x:Name="CompactActions" Content="功能" Click="CompactActionsClick" DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Top" Visibility="Collapsed"/>
     <Button x:Name="ClearConversationButton" Content="清除對話…" Click="ClearConversationClick" DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Top"/>
     <StackPanel><TextBlock x:Name="ConversationTitle" Text="選擇一位同學" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ConversationMeta" Text="對話紀錄保存在本機" Foreground="#596B80" FontSize="12" TextWrapping="Wrap"/></StackPanel>
    </DockPanel></Border>
    <Border x:Name="TrustBanner" Grid.Row="1" Background="#FFF8E8" Padding="16,6" Visibility="Collapsed"><TextBlock x:Name="TrustBannerText" Text="含舊版訊息；舊版確認不代表對方已儲存或已讀。" Foreground="#916015" FontSize="12" TextWrapping="Wrap"/></Border>
    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Button x:Name="OlderMessages" Content="載入更早訊息" Click="OlderMessagesClick" HorizontalAlignment="Center" Margin="8" Visibility="Collapsed"/>
     <local:MessageHistoryView x:Name="History" Grid.Row="1" BorderThickness="0" Padding="16,8" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.ScrollChanged="HistoryScrolled">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Focusable" Value="False"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><local:MessageCard Message="{Binding}"/></DataTemplate></ListBox.ItemTemplate>
     </local:MessageHistoryView>
     <TextBlock x:Name="HistoryState" Grid.Row="1" Text="尚未選擇對象" Foreground="#596B80" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
     <Button x:Name="NewMessages" Grid.Row="2" Content="有新訊息，移到最新" Click="NewMessagesClick" HorizontalAlignment="Center" Visibility="Collapsed" Margin="8"/>
    </Grid>
    <Border Grid.Row="3" BorderBrush="#DCE3EC" BorderThickness="0,1,0,0" Padding="16,12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer x:Name="ComposerToolsScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="170"><StackPanel>
     <WrapPanel x:Name="TeacherReactions" Margin="0,0,0,8"><TextBlock Text="傳給老師：" VerticalAlignment="Center" FontSize="12" Foreground="#596B80"/><Button Style="{StaticResource PillButton}" Content="講太快了" Tag="too-fast" Click="ReactionSendClick" Margin="0,0,8,4"/><Button Style="{StaticResource PillButton}" Content="跟不上" Tag="cant-keep-up" Click="ReactionSendClick" Margin="0,0,8,4"/><Button Style="{StaticResource PillButton}" Content="聽不懂" Tag="dont-understand" Click="ReactionSendClick" Margin="0,0,8,4"/><Button Style="{StaticResource PillButton}" Content="再講一次" Tag="say-again" Click="ReactionSendClick" Margin="0,0,8,4"/><TextBlock Text="傳給目前對象：" VerticalAlignment="Center" FontSize="12" Foreground="#596B80"/><Button x:Name="ScrollReaction" Style="{StaticResource PillButton}" Content="你再給我滑！" Tag="stop-scrolling" Click="ReactionSendClick" Margin="0,0,0,4"/></WrapPanel>
     <Border x:Name="AttemptBanner" Background="#FFF8E8" BorderBrush="#ECD9A8" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,8" Visibility="Collapsed"><StackPanel><TextBlock x:Name="AttemptText" Foreground="#916015" TextWrapping="Wrap"/><WrapPanel Margin="0,6,0,0"><Button x:Name="RetryAttempt" Content="重送（沿用原 id）" Click="RetryAttemptClick" Margin="0,0,8,0"/><Button x:Name="CancelAttemptButton" Content="取消當次" Click="CancelAttemptClick"/></WrapPanel></StackPanel></Border>
     </StackPanel></ScrollViewer>
     <Border x:Name="ComposerBorder" Grid.Row="1" BorderBrush="#DCE3EC" BorderThickness="1" CornerRadius="8" Padding="8" AllowDrop="True" PreviewDragOver="ComposerDragOver" PreviewDragLeave="ComposerDragLeave" PreviewDrop="ComposerDrop"><Grid x:Name="ComposerBox"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="CodeToolbarRow" Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="Draft" Grid.Row="0" Grid.ColumnSpan="2" AcceptsReturn="True" Height="72" MaxHeight="120" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="4" PreviewKeyDown="DraftPreviewKeyDown" TextChanged="DraftEdited" AutomationProperties.Name="訊息草稿" AllowDrop="True" PreviewDragOver="ComposerDragOver" PreviewDragLeave="ComposerDragLeave" PreviewDrop="ComposerDrop"/>
      <Button x:Name="SendButton" Style="{StaticResource PrimaryButton}" Grid.Row="1" Grid.Column="1" Content="傳送" Click="SendClick" Margin="8,8,0,0"/>
      <WrapPanel x:Name="CodeToolbar" Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" VerticalAlignment="Center">
       <Button x:Name="AttachFileButton" Style="{StaticResource CircleIconButton}" ToolTip="附加檔案或相片" Click="AttachFileClick" Margin="0,0,8,0">
        <Path Data="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" Stroke="#4B5563" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Button>
       <Button x:Name="InsertCodeButton" Content="插入程式碼" Click="InsertCodeClick" Height="26" MinHeight="26" Padding="8,2" FontSize="12" VerticalContentAlignment="Center" Margin="0,0,6,0"/>
       <ComboBox x:Name="CodeLanguage" Style="{StaticResource CompactComboBox}" ItemContainerStyle="{StaticResource CompactComboBoxItem}" SelectedIndex="0" Width="82" Height="26" FontSize="12" VerticalContentAlignment="Center" AutomationProperties.Name="程式碼語言"><ComboBoxItem Content="Python" Tag="python"/><ComboBoxItem Content="C#" Tag="csharp"/><ComboBoxItem Content="JavaScript" Tag="javascript"/><ComboBoxItem Content="純文字" Tag="text"/></ComboBox>
      </WrapPanel>
     </Grid></Border>
     <TextBlock Grid.Row="2" x:Name="DraftStatus" Text="Enter 傳送 · Shift＋Enter 換行" Foreground="#596B80" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </Grid></Border>
   </Grid>
  </Grid>
  <Border Grid.Row="1" Visibility="Collapsed" BorderBrush="#DCE3EC" BorderThickness="0,1,0,0" Padding="16,6"><ScrollViewer MaxHeight="76" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="SettingsSaveStatus" Foreground="#B43E3E" TextWrapping="Wrap" FontSize="12" Visibility="Collapsed"/><TextBlock x:Name="StorageStatus" Foreground="#B43E3E" TextWrapping="Wrap" FontSize="12"/><TextBlock x:Name="ReceiverStatus" Text="接收服務啟動中…" Foreground="#596B80" TextWrapping="Wrap" FontSize="12"/><TextBlock x:Name="Status" Text="載入本機資料中…" Foreground="#596B80" FontSize="12" TextWrapping="Wrap"/><Button x:Name="ReloadData" Content="重新讀取" Click="ReloadDataClick" HorizontalAlignment="Left" Visibility="Collapsed"/></StackPanel></ScrollViewer></Border>
  <Border x:Name="SettingsPane" Grid.RowSpan="2" Background="#F3F6FA" BorderBrush="#DCE3EC" BorderThickness="1" Margin="16" Padding="16" Visibility="Collapsed">
   <DockPanel><Button Content="完成" Click="CloseSettingsClick" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0"/>
    <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ChatLayout">
     <TextBlock Text="名單與設定" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
     <TextBlock x:Name="MyDirectIP" Text="我的 IP：偵測中…" TextWrapping="Wrap"/><Button x:Name="CopyMyIPButton" Content="複製我的 IP" Click="CopyMyIPClick" HorizontalAlignment="Left" Margin="0,8"/>
     <CheckBox x:Name="AutoStartCheck" Content="開機啟動" Checked="AutoStartChecked" Unchecked="AutoStartUnchecked" Margin="0,8,0,16"/>
     <StackPanel x:Name="ArchivedIdentityPanel" Visibility="Collapsed">
     <Button x:Name="CheckIdentityButton" Content="檢查本機身分…" Click="CheckIdentityClick" HorizontalAlignment="Left" Margin="0,0,0,8"/>
     <TextBlock x:Name="IdentityRecoveryStatus" Text="檢查不會自動建立或替換身分。" TextWrapping="Wrap" Foreground="#596B80" FontSize="12" Margin="0,0,0,16"/>
     <TextBlock Text="目前同學的配對與信任" FontWeight="Bold"/>
     <TextBlock x:Name="PairingStatus" Text="先選擇已儲存的名單。" Foreground="#596B80" TextWrapping="Wrap" Margin="0,6,0,8"/>
     <WrapPanel><Button x:Name="OpenPairingButton" Content="核對與綁定…" Click="OpenPairingClick" IsEnabled="False" Margin="0,0,8,8"/><Button x:Name="UnlinkPeerButton" Content="解除名單綁定…" Click="UnlinkPeerClick" IsEnabled="False" Margin="0,0,8,8"/><Button x:Name="RevokePeerButton" Content="撤銷這個身分…" Click="RevokePeerClick" IsEnabled="False" Margin="0,0,8,8"/><Button x:Name="ResetPeerButton" Content="允許重新核對…" Click="ResetPeerClick" IsEnabled="False" Margin="0,0,0,8"/></WrapPanel>
     <TextBlock Text="解除綁定會保留對話與身分信任；撤銷影響所有綁定同一身分的名單。允許重新核對不會直接完成配對。" Foreground="#596B80" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,20"/>
     </StackPanel>
     <TextBlock x:Name="ManualRosterTitle" Text="手動新增同學" FontWeight="Bold"/>
     <TextBlock Text="姓名" Margin="0,8,0,4"/><TextBox x:Name="ContactName" AutomationProperties.Name="同學姓名"/>
     <TextBlock Text="學號（可留白）" Margin="0,8,0,4"/><TextBox x:Name="StudentNumberBox" AutomationProperties.Name="學號"/>
     <TextBlock Text="內網 IP（可留白）" Margin="0,8,0,4"/><TextBox x:Name="RecipientIp" TextChanged="RecipientChanged" AutomationProperties.Name="同學內網 IP"/>
     <CheckBox x:Name="TeacherLabel" Content="老師標籤（不授權）" Margin="0,8"/>
     <WrapPanel Margin="0,4,0,0">
      <Button x:Name="SaveContactButton" Content="新增到名單" Click="SaveContactClick" HorizontalAlignment="Left"/>
      <Button x:Name="DeleteContactButton" Content="移除此名單標籤" Click="DeleteRosterClick" HorizontalAlignment="Left" Margin="8,0,0,0" IsEnabled="False"/>
      <TextBlock x:Name="SaveContactFeedback" Foreground="DarkGreen" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"/>
     </WrapPanel>
     <ComboBox x:Name="ContactsCombo" SelectionChanged="ContactsComboChanged" Visibility="Collapsed"/>
     <TextBlock Text="課堂反應" FontWeight="Bold" Margin="0,20,0,8"/><TextBlock Text="老師 IP"/><TextBox x:Name="TeacherIpBox" AutomationProperties.Name="老師 IP"/>
     <Button Content="記住老師" Click="SaveTeacherClick" HorizontalAlignment="Left" Margin="0,8"/><TextBlock x:Name="TeacherTarget" TextWrapping="Wrap"/><TextBlock x:Name="ScrollTarget" TextWrapping="Wrap" Margin="0,8"/>
     <TextBlock Text="提醒螢幕" Margin="0,8"/><ComboBox x:Name="ReactionDisplay" DisplayMemberPath="Label" SelectedValuePath="DeviceName" SelectionChanged="ReactionDisplayChanged" DropDownOpened="ReactionDisplayOpened" AutomationProperties.Name="提醒螢幕"/>
     <CheckBox x:Name="ReactionPreviewToggle" Content="允許桌面顯示課堂反應圖片（可能透露內容）" Click="ReactionPreviewToggleClick" Margin="0,12,0,4"/>
     <CheckBox x:Name="ReadReceiptToggle" IsChecked="True" Content="傳送對外已讀回條（預設開啟）" Click="ReadReceiptToggleClick" Margin="0,20,0,4"/><TextBlock Text="本機看過才標已讀。關閉不影響本機未讀，未送出的回條會移除；已送出的回條無法撤回。" Foreground="#596B80" FontSize="12" TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer>
   </DockPanel>
  </Border>
 </Grid>
</Window>
