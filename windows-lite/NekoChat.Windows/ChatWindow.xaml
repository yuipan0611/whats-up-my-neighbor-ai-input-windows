<Window x:Class="NekoChat.Windows.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NekoChat" Width="480" Height="740" MinWidth="440" MinHeight="360"
        Background="#FAF9F7" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="16">
        <ScrollViewer DockPanel.Dock="Bottom" MaxHeight="64" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="ReceiverStatus" Text="接收服務啟動中…"
                   Foreground="#64748B" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </ScrollViewer>
        <TextBlock DockPanel.Dock="Bottom" Text="Enter 傳送 · Shift＋Enter 換行" FontSize="11"
                   Foreground="#64748B" Margin="0,6,0,0"/>
        <!-- 底部狀態 -->
        <ScrollViewer DockPanel.Dock="Bottom" MaxHeight="48" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="Status" Text="就緒"
                   Foreground="#64748B" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </ScrollViewer>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Settings shrink and scroll; the composer never scrolls out of view. -->
            <ScrollViewer x:Name="SettingsScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- 1. 頂部我的 IP 與開機啟動 -->
                    <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <DockPanel>
                            <CheckBox x:Name="AutoStartCheck" Content="開機啟動" DockPanel.Dock="Right"
                                      VerticalAlignment="Center" FontSize="12" Foreground="#475569"
                                      Checked="AutoStartChecked" Unchecked="AutoStartUnchecked"/>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock x:Name="MyDirectIP" Text="我的 IP：偵測中…" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button x:Name="CopyMyIPButton" Content="複製" Click="CopyMyIPClick" Padding="8,2" FontSize="11" Background="White" BorderBrush="#CBD5E1" Cursor="Hand"/>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <!-- 2. 對象與通訊錄 -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RecipientIp" Grid.Column="0" Margin="0,0,4,0" Padding="5,3" FontSize="12" TextChanged="RecipientChanged" ToolTip="輸入同學 IP（例如 192.168.1.25）"/>
                        <ComboBox x:Name="ContactsCombo" Grid.Column="1" Margin="0,0,4,0" SelectionChanged="ContactsComboChanged" FontSize="12" ToolTip="快速選擇常用同學"/>
                        <TextBox x:Name="ContactName" Grid.Column="2" Margin="0,0,4,0" Padding="5,3" FontSize="12" ToolTip="名稱／座位備註（例如 隔壁小明）"/>
                        <Button x:Name="SaveContactButton" Grid.Column="3" Content="記住" Click="SaveContactClick" Padding="8,3" FontSize="12" Cursor="Hand"/>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <WrapPanel Margin="0,0,0,6" VerticalAlignment="Center">
                            <TextBlock Text="老師 IP：" VerticalAlignment="Center"/>
                            <TextBox x:Name="TeacherIpBox" Width="120" Padding="5,3" AutomationProperties.Name="老師 IP"/>
                            <Button Content="記住老師" Click="SaveTeacherClick" Padding="8,3" Margin="6,0,0,0"/>
                        </WrapPanel>
                        <TextBlock x:Name="TeacherTarget" Foreground="#475569" FontSize="12" Margin="0,0,0,4"/>
                        <UniformGrid x:Name="TeacherReactions" Columns="2" Margin="0,0,0,4">
                            <Button Content="講太快了" Tag="too-fast" Click="ReactionSendClick" Padding="4,6" Margin="0,0,4,4"/>
                            <Button Content="跟不上" Tag="cant-keep-up" Click="ReactionSendClick" Padding="4,6" Margin="0,0,0,4"/>
                            <Button Content="聽不懂" Tag="dont-understand" Click="ReactionSendClick" Padding="4,6" Margin="0,0,4,0"/>
                            <Button Content="再講一次" Tag="say-again" Click="ReactionSendClick" Padding="4,6"/>
                        </UniformGrid>
                        <Button x:Name="ScrollReaction" Content="你再給我滑！" Tag="stop-scrolling" Click="ReactionSendClick" Padding="4,6"/>
                        <TextBlock x:Name="ScrollTarget" Text="傳給上方選定的聊天對象" FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <DockPanel>
                            <TextBlock Text="提醒螢幕：" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ReactionDisplay" DisplayMemberPath="Label" SelectedValuePath="DeviceName" SelectionChanged="ReactionDisplayChanged" DropDownOpened="ReactionDisplayOpened" AutomationProperties.Name="提醒螢幕"/>
                        </DockPanel>
                        <TextBlock Text="中央放大 1.5 倍 · 停留 2 秒 · 圖片泡泡不顯示 IP" Foreground="#64748B" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>

                </Grid>
            </ScrollViewer>

            <!-- 3. 對話紀錄 -->
            <TextBox x:Name="History" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Background="White" BorderBrush="#CBD5E1"
                     Padding="8" FontSize="13" FontFamily="Segoe UI, Microsoft JhengHei" Margin="0,0,0,8"/>

            <!-- 4. 輸入框與發送 -->
            <DockPanel Grid.Row="2">
                <Button x:Name="SendButton" Content="傳送" Click="SendClick" DockPanel.Dock="Right"
                        Width="70" Margin="6,0,0,0" FontWeight="Bold" FontSize="13"
                        Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <TextBox x:Name="Draft" AcceptsReturn="True" Height="55" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Background="White" BorderBrush="#CBD5E1"
                         Padding="6" FontSize="13" FontFamily="Segoe UI, Microsoft JhengHei" PreviewKeyDown="DraftPreviewKeyDown"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>

