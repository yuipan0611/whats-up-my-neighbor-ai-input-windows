<Window x:Class="NekoChat.Windows.ChatWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NekoChat · Windows Lite" Width="470" Height="720" MinWidth="400" MinHeight="560" Background="#FAF9F7">
 <DockPanel Margin="20">
  <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Text="尚未連線" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
  <TabControl x:Name="Tabs">
   <TabItem Header="開始使用"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
    <TextBlock Text="開始與同學聊天" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <TextBlock Text="沒有麥克風也能使用。文字聊天不需要 Groq Key，語音設定可以跳過。" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <Button x:Name="SkipVoiceButton" Content="跳過語音，先用文字聊天" Click="SkipVoiceClick" HorizontalAlignment="Left"/>
    <Expander x:Name="VoiceSetup" Header="語音設定（可選，之後也能補）" IsExpanded="True" Margin="0,8,0,0">
     <StackPanel Margin="0,8,0,0">
      <TextBlock Text="自己的 Groq API Key"/><PasswordBox x:Name="GroqKey" MaxLength="256" AutomationProperties.Name="Groq API Key（可跳過）"/>
      <WrapPanel><Button Content="儲存 Groq Key" Click="SaveGroqClick"/><Button Content="刪除 Groq Key" Click="DeleteGroqClick"/></WrapPanel>
      <TextBlock Text="需要麥克風才設定。金鑰只存這台電腦的 Windows 認證管理員；錄音會送至 Groq 轉成文字。" TextWrapping="Wrap" Foreground="#666666" FontSize="12"/>
     </StackPanel>
    </Expander>
    <TextBlock x:Name="GroqState" Text="尚未設定語音。可以直接建立或加入房間，互傳文字訊息。" TextWrapping="Wrap" Margin="0,6,0,6"/>
    <Separator Margin="0,16"/>
    <TextBlock x:Name="RoomHeading" Text="全班共用教室房間" FontSize="18" FontWeight="SemiBold"/>
    <TextBlock Text="老師建立房間，全班貼同一份邀請碼加入（最多 100 台）。可直接 Ping 老師，或填同學 IP 私訊。" TextWrapping="Wrap" Margin="0,8"/>
    <Button x:Name="CreateRoomButton" Content="建立教室房間（老師）" Click="CreateRoomClick" HorizontalAlignment="Left"/>
    <StackPanel x:Name="ShareRoomPanel" Visibility="Collapsed">
     <TextBlock Text="給同學的邀請碼" Margin="0,8,0,0"/>
     <TextBox x:Name="RoomCode" IsReadOnly="True" Height="75" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="給同學的邀請碼"/>
     <Button Content="複製邀請碼" Click="CopyRoomCodeClick" HorizontalAlignment="Left"/>
     <TextBlock Text="只把邀請碼分享給這個教室的同學，即授權加入後彼此傳訊。房主離開後失效。" TextWrapping="Wrap" Foreground="#666666" FontSize="12"/>
    </StackPanel>
    <TextBlock Text="同學給你的邀請碼" Margin="0,14,0,0"/>
    <TextBox x:Name="JoinRoomCode" Height="62" TextWrapping="Wrap" MaxLength="4096" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="同學給你的邀請碼"/>
    <WrapPanel><Button x:Name="JoinRoomButton" Content="加入房間" Click="JoinRoomClick"/><Button x:Name="LeaveRoomButton" Content="取消／離開房間" Click="LeaveRoomClick" IsEnabled="False"/></WrapPanel>
    <TextBlock x:Name="RoomStatus" Text="未加入房間。直接建立房間，或貼上同學的邀請碼即可聊天。" TextWrapping="Wrap" Margin="0,8" AutomationProperties.LiveSetting="Polite"/>
    <TextBlock Text="全班電腦需能連到老師的教室主機。Windows 若詢問網路存取權，請依學校規範允許；網路隔離時需由管理者提供連線。" TextWrapping="Wrap" Foreground="#666666" FontSize="12"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="聊天"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
    <TextBlock x:Name="MyRoomAddress" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock x:Name="RecipientLabel" Text="好友 ID"/><TextBox x:Name="Recipient" MaxLength="32" AutomationProperties.Name="傳訊對象"/>
    <TextBox x:Name="History" IsReadOnly="True" Height="190" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="本次聊天紀錄"/>
    <TextBlock Text="訊息（語音先成為草稿，按傳送才送出）" TextWrapping="Wrap"/>
    <TextBox x:Name="Draft" AcceptsReturn="True" Height="100" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="訊息草稿"/>
    <WrapPanel><Button x:Name="SendButton" Content="傳送" Click="SendClick" IsEnabled="False"/><Button x:Name="TeacherButton" Content="Ping 老師／傳送草稿" Click="PingTeacherClick" Visibility="Collapsed" IsEnabled="{Binding IsEnabled, ElementName=SendButton}"/><Button x:Name="VoiceButton" Content="🎙 語音草稿" Click="VoiceClick"/><Button Content="取消錄音" Click="CancelClick"/></WrapPanel>
    <TextBlock Text="全系統語音輸入：Ctrl + Alt + Space 開始／停止。Esc 取消。錄音最長 60 秒。" TextWrapping="Wrap" Margin="0,12,0,12"/>
    <TextBlock Text="最近轉錄（不儲存至磁碟）"/><TextBox x:Name="Transcript" IsReadOnly="True" Height="65" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="最近轉錄"/>
    <Button Content="複製最近轉錄" Click="CopyClick" HorizontalAlignment="Left"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="進階連線"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
    <TextBlock Text="連線模式"/><ComboBox x:Name="Mode" SelectedIndex="0" SelectionChanged="ModeChanged" Margin="0,5,0,12"><ComboBoxItem Content="LAN（可信任教室網路）"/><ComboBoxItem Content="VPS（必須 WSS）"/></ComboBox>
    <TextBlock Text="Relay 位址"/><TextBox x:Name="Endpoint" AutomationProperties.Name="Relay 位址"/>
    <TextBlock Text="我的帳號 ID"/><TextBox x:Name="UserId" MaxLength="32" AutomationProperties.Name="我的帳號 ID"/>
    <TextBlock Text="個人 Relay 憑證（空白保留已存憑證）" TextWrapping="Wrap"/><PasswordBox x:Name="RelayToken" MaxLength="256" AutomationProperties.Name="個人 Relay 憑證"/>
    <WrapPanel><Button x:Name="ConnectButton" Content="儲存並連線" Click="ConnectClick"/><Button Content="中斷連線" Click="DisconnectClick"/></WrapPanel>
    <Button Content="刪除此連線的已存憑證" Click="DeleteRelayClick" HorizontalAlignment="Left"/>
    <TextBlock Text="教室測試請使用『開始使用』的建立／加入房間。此頁保留給管理者提供的 LAN 或 VPS 連線。" TextWrapping="Wrap" Margin="0,12"/>
    <TextBlock Text="朋友需要由 Relay 管理者設定雙向授權。若學校隔離電腦互連，改用已設定的 VPS WSS Relay。" TextWrapping="Wrap"/>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </DockPanel>
</Window>
