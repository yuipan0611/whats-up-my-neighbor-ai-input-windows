<Window x:Class="NekoChat.Windows.ChatWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NekoChat.Windows"
 Title="Neko Chat Lite" Icon="Assets/app.ico" Width="1100" Height="740" MinWidth="440" MinHeight="360" Background="White" Foreground="#1C2C41"
 FontFamily="Microsoft JhengHei UI, Microsoft JhengHei" FontSize="13" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="10,5"/>
   <Setter Property="MinHeight" Value="28"/>
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#DCE3EC"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Foreground" Value="#1C2C41"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="#F3F6FA"/><Setter TargetName="border" Property="BorderBrush" Value="#2859C5"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="border" Property="Background" Value="#E9EFFD"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="border" Property="Opacity" Value="0.5"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button">
   <Setter Property="Padding" Value="18,8"/>
   <Setter Property="MinHeight" Value="38"/>
   <Setter Property="Background" Value="#2859C5"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="#1E429F"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="border" Property="Background" Value="#1A367E"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="border" Property="Opacity" Value="0.5"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Padding" Value="10,3"/>
   <Setter Property="MinHeight" Value="24"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="#F3F6FA"/><Setter TargetName="border" Property="BorderBrush" Value="#2859C5"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="border" Property="Background" Value="#E9EFFD"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="border" Property="Opacity" Value="0.5"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="CircleIconButton" TargetType="Button">
   <Setter Property="Background" Value="#EDF2F8"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Width" Value="28"/>
   <Setter Property="Height" Value="28"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="14" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" SnapsToDevicePixels="True">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="#DCE3EC"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="border" Property="Background" Value="#CBD5E1"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="border" Property="Opacity" Value="0.4"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="CompactComboBox" TargetType="ComboBox">
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#DCE3EC"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Foreground" Value="#1C2C41"/>
   <Setter Property="SnapsToDevicePixels" Value="True"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBox">
      <Grid>
       <ToggleButton x:Name="ToggleButton" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
        <ToggleButton.Template>
         <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="border" Background="White" BorderBrush="#DCE3EC" BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
           <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
            <Path x:Name="arrow" Grid.Column="1" Data="M0 0 L4 4 L8 0" Stroke="#596B80" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
           </Grid>
          </Border>
          <ControlTemplate.Triggers>
           <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="#2859C5"/><Setter TargetName="border" Property="Background" Value="#F3F6FA"/></Trigger>
           <Trigger Property="IsChecked" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="#2859C5"/></Trigger>
          </ControlTemplate.Triggers>
         </ControlTemplate>
        </ToggleButton.Template>
       </ToggleButton>
       <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="8,0,24,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
       <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
        <Border x:Name="DropDownBorder" Background="White" BorderBrush="#DCE3EC" BorderThickness="1" CornerRadius="6" Margin="0,2,0,0" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True">
         <ScrollViewer Margin="2" SnapsToDevicePixels="True">
          <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
         </ScrollViewer>
        </Border>
       </Popup>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="HasItems" Value="false"><Setter TargetName="DropDownBorder" Property="MinHeight" Value="95"/></Trigger>
       <Trigger Property="IsEnabled" Value="false"><Setter Property="Opacity" Value="0.5"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="CompactComboBoxItem" TargetType="ComboBoxItem">
   <Setter Property="Padding" Value="8,4"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="Border" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="4" Margin="2,1" SnapsToDevicePixels="True">
       <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Border" Property="Background" Value="#EDF2F8"/><Setter Property="Foreground" Value="#2859C5"/></Trigger>
       <Trigger Property="IsSelected" Value="True"><Setter TargetName="Border" Property="Background" Value="#E9EFFD"/><Setter Property="Foreground" Value="#2859C5"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="8,5"/>
   <Setter Property="BorderBrush" Value="#DCE3EC"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Background" Value="White"/>
   <Setter Property="Foreground" Value="#1C2C41"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TextBox">
      <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
       <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Padding="{TemplateBinding Padding}"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="#2859C5"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="InboxItem" TargetType="ListBoxItem">
   <Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="RowBackground" Background="{TemplateBinding Background}" Padding="16,8"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBackground" Property="Background" Value="#EDF2F8"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="RowBackground" Property="Background" Value="#E9EFFD"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="RowBackground" Property="BorderBrush" Value="#2859C5"/><Setter TargetName="RowBackground" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="Shell" SizeChanged="ShellSizeChanged">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="InboxColumn" Width="274"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="InboxPane" Grid.Column="0" BorderBrush="#DCE3EC" BorderThickness="0,0,1,0">
    <DockPanel>
     <ScrollViewer x:Name="SidebarHeaderScroll" DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="16,16,16,8">
      <StackPanel x:Name="BrandHeader" Orientation="Horizontal" Margin="0,0,0,12"><Image Source="Assets/original.png" Width="36" Height="36" Margin="0,0,8,0"/><TextBlock Text="Neko Chat Lite" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/></StackPanel>
      <TextBlock x:Name="TeacherSectionTitle" Text="老師" FontWeight="Bold" Foreground="#2859C5" Margin="0,0,0,6"/>
      <ListBox x:Name="TeachersList" MaxHeight="92" BorderThickness="0" SelectionChanged="TeacherSelectionChanged" ItemContainerStyle="{StaticResource InboxItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="置頂老師聊天室"/>
      <Button x:Name="SetTeacherButton" Content="＋ 加入老師" Click="AddTeacherClick" HorizontalAlignment="Left" Margin="0,0,0,12"/>
      <Button x:Name="TeacherFilesButton" Content="▤  課堂檔案" Click="TeacherFilesClick" HorizontalContentAlignment="Left" Background="#FAFBFD" Foreground="#536781" Margin="0,6,0,14" Padding="12,8" AutomationProperties.Name="課堂檔案"/>
      <Grid><TextBox x:Name="InboxSearch" TextChanged="InboxSearchChanged" AutomationProperties.Name="搜尋 IP 或綽號" ToolTip="搜尋 IP 或本機綽號" Margin="0,0,0,8"/><TextBlock x:Name="InboxSearchHint" Text="搜尋 IP 或綽號" Foreground="#8A96A7" FontSize="12" Margin="10,7,0,0" IsHitTestVisible="False"/></Grid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="InboxCount" Text="同學" Foreground="#69778A" FontSize="12" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="FilterAllButton" Content="全部" Click="FilterAllClick" Padding="8,3" FontSize="12" Margin="0,0,4,0"/><Button x:Name="FilterUnreadButton" Content="未讀" Click="FilterUnreadClick" Padding="8,3" FontSize="12"/></StackPanel></Grid>
      <ComboBox x:Name="InboxFilter" SelectedIndex="0" Margin="0,6,0,0" SelectionChanged="InboxFilterChanged" AutomationProperties.Name="名單篩選"><ComboBoxItem Content="一般聯絡人"/><ComboBoxItem Content="未讀"/><ComboBoxItem Content="封存（歷史唯讀）"/><ComboBoxItem Content="已封鎖（歷史唯讀）"/></ComboBox>
     </StackPanel></ScrollViewer>
     <StackPanel x:Name="SidebarFooter" DockPanel.Dock="Bottom" Margin="16,12">
      <WrapPanel VerticalAlignment="Center">
       <Button Content="＋ 新增對象" Click="AddRosterClick" Height="30" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,8,8"/>
       <Button Content="設定" Click="OpenSettingsClick" Height="30" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
      </WrapPanel>
      <TextBlock x:Name="NicknameHint" Text="右鍵或對話 ⋯ 可管理聯絡人與本機備註" Foreground="#69778A" FontSize="11" Margin="0,4"/>
      <TextBlock x:Name="IdentityStatus" Visibility="Collapsed" Text="教室區域網路・依名單 IP" Foreground="#596B80" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
     </StackPanel>
     <Grid><ListBox x:Name="InboxList" BorderThickness="0" SelectionChanged="InboxSelectionChanged" ItemContainerStyle="{StaticResource InboxItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
      <ListBox.ItemTemplate><DataTemplate><Grid AutomationProperties.Name="{Binding AccessibleLabel}"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Grid Width="36" Height="36" VerticalAlignment="Top" Margin="0,2,0,0"><Image Source="{Binding Avatar}" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/><Ellipse Visibility="Collapsed" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{Binding DotFill}" Stroke="{Binding DotStroke}" StrokeThickness="2" StrokeDashArray="{Binding DotDash}"/></Grid>
       <StackPanel Grid.Column="1" Margin="8,0,4,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Secondary}" Foreground="#596B80" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Draft}" Foreground="#916015" FontSize="12"/></StackPanel>
       <Border Grid.Column="2" Background="#2859C5" CornerRadius="10" VerticalAlignment="Top" Padding="6,0" Visibility="{Binding BadgeVisibility}"><TextBlock Text="{Binding Badge}" Foreground="White" FontSize="12"/></Border>
      </Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox><StackPanel x:Name="InboxEmptyPanel" Margin="16" Visibility="Collapsed"><TextBlock x:Name="InboxEmpty" Text="尚無同學，按「加入好友」輸入對方 IP。" TextWrapping="Wrap" Foreground="#596B80" Margin="0,0,0,12"/><Button x:Name="AddFirstContactButton" Style="{StaticResource PrimaryButton}" Content="＋ 點此新增第一個聊天對象" Click="AddRosterClick" HorizontalAlignment="Left"/></StackPanel></Grid>
    </DockPanel>
   </Border>
   <Grid x:Name="ConversationPane" Grid.Column="1" AllowDrop="True" PreviewDragOver="ComposerDragOver" PreviewDragLeave="ComposerDragLeave" PreviewDrop="ComposerDrop">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border BorderBrush="#DCE3EC" BorderThickness="0,0,0,1" Padding="22,14"><DockPanel>
     <Button x:Name="BackToInbox" Content="← 返回名單" Click="BackToInboxClick" DockPanel.Dock="Left" Margin="0,0,12,0" Visibility="Collapsed"/>
     <Button x:Name="CompactActions" Content="課堂反應" Click="CompactActionsClick" DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Top" Visibility="Collapsed"/>
     <Button x:Name="ConversationMenuButton" Content="⋯" Click="ConversationMenuClick" DockPanel.Dock="Right" Width="36" Height="32" Padding="4" FontSize="20" BorderThickness="0" AutomationProperties.Name="對話選單"/>
     <Button x:Name="ClearConversationButton" Content="清除對話…" Visibility="Collapsed" Click="ClearConversationClick"/>
     <StackPanel><TextBlock x:Name="ConversationTitle" Text="選擇一位同學" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ConversationMeta" Text="對話紀錄保存在本機" Foreground="#596B80" FontSize="12" TextWrapping="Wrap"/></StackPanel>
    </DockPanel></Border>
    <Border x:Name="TrustBanner" Grid.Row="1" Background="#FFF8E8" Padding="16,6" Visibility="Collapsed"><TextBlock x:Name="TrustBannerText" Text="含舊版訊息；舊版確認不代表對方已儲存或已讀。" Foreground="#916015" FontSize="12" TextWrapping="Wrap"/></Border>
    <Grid x:Name="ChatHistoryPanel" Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Button x:Name="OlderMessages" Content="載入更早訊息" Click="OlderMessagesClick" HorizontalAlignment="Center" Margin="8" Visibility="Collapsed"/>
     <local:MessageHistoryView x:Name="History" Grid.Row="1" BorderThickness="0" Padding="16,8" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.ScrollChanged="HistoryScrolled">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Focusable" Value="False"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><local:MessageCard Message="{Binding}"/></DataTemplate></ListBox.ItemTemplate>
     </local:MessageHistoryView>
     <TextBlock x:Name="HistoryState" Grid.Row="1" Text="尚未選擇對象" Foreground="#596B80" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
     <Button x:Name="NewMessages" Grid.Row="2" Content="有新訊息，移到最新" Click="NewMessagesClick" HorizontalAlignment="Center" Visibility="Collapsed" Margin="8"/>
    </Grid>
    <Grid x:Name="TeacherFilesPane" Grid.Row="1" Grid.RowSpan="3" Background="#FCFDFF" Visibility="Collapsed" Margin="20,16">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,16"><Button x:Name="UploadClassroomFileButton" Content="＋ 上傳檔案" Click="UploadClassroomFileClick" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0"/><TextBlock x:Name="ClassroomHostState" Text="老師與同學分享的課堂資料" FontSize="12" Foreground="#69778A" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
     <Border x:Name="ShareUploadPanel" Grid.Row="1" Background="#F1F5FC" Padding="10" Margin="0,0,0,10" Visibility="Collapsed"><DockPanel><Button x:Name="RetryClassroomUpload" Content="重試" DockPanel.Dock="Right" Click="RetryClassroomUploadClick"/><Button Content="取消" DockPanel.Dock="Right" Click="CancelClassroomUploadClick" Margin="6,0"/><TextBlock x:Name="ShareUploadState" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></Border>
     <ListBox x:Name="TeacherFilesList" Grid.Row="2" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VirtualizingStackPanel.IsVirtualizing="True" AutomationProperties.Name="課堂檔案清單">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Focusable" Value="False"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><local:ClassroomFileCard File="{Binding}"/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock x:Name="TeacherFilesState" Grid.Row="2" Text="載入課堂檔案中…" Foreground="#69778A" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     <Button x:Name="MoreTeacherFilesButton" Grid.Row="3" Content="載入更多檔案" Click="MoreTeacherFilesClick" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,12,0,0"/>
    </Grid>
    <Border x:Name="ComposerPanel" Grid.Row="3" BorderBrush="#DCE3EC" BorderThickness="0,1,0,0" Padding="16,12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer x:Name="ComposerToolsScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="170"><StackPanel>
     <WrapPanel x:Name="TeacherReactions" Margin="0,0,0,8"><TextBlock Text="課堂反應" VerticalAlignment="Center" FontSize="12" Foreground="#596B80"/><Button Style="{StaticResource PillButton}" Content="講太快了" Tag="too-fast" Click="ReactionSendClick" Margin="0,0,8,4"/><Button Style="{StaticResource PillButton}" Content="跟不上" Tag="cant-keep-up" Click="ReactionSendClick" Margin="0,0,8,4"/><Button Style="{StaticResource PillButton}" Content="聽不懂" Tag="dont-understand" Click="ReactionSendClick" Margin="0,0,8,4"/><Button Style="{StaticResource PillButton}" Content="再講一次" Tag="say-again" Click="ReactionSendClick" Margin="0,0,8,4"/></WrapPanel><WrapPanel x:Name="PeerReactions" Margin="0,0,0,8"><TextBlock Text="傳給目前對象：" VerticalAlignment="Center" FontSize="12" Foreground="#596B80"/><Button x:Name="ScrollReaction" Style="{StaticResource PillButton}" Content="你再給我滑！" Tag="stop-scrolling" Click="ReactionSendClick" Margin="0,0,0,4"/></WrapPanel>
     <Border x:Name="AttemptBanner" Background="#FFF8E8" BorderBrush="#ECD9A8" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,8" Visibility="Collapsed"><StackPanel><TextBlock x:Name="AttemptText" Foreground="#916015" TextWrapping="Wrap"/><WrapPanel Margin="0,6,0,0"><Button x:Name="RetryAttempt" Content="重試傳送" Click="RetryAttemptClick" Margin="0,0,8,0"/><Button x:Name="CancelAttemptButton" Content="取消當次" Click="CancelAttemptClick"/></WrapPanel></StackPanel></Border>
     </StackPanel></ScrollViewer>
     <Border x:Name="ComposerBorder" Grid.Row="1" BorderBrush="#DCE3EC" BorderThickness="1" CornerRadius="8" Padding="8" AllowDrop="True" PreviewDragOver="ComposerDragOver" PreviewDragLeave="ComposerDragLeave" PreviewDrop="ComposerDrop"><Grid x:Name="ComposerBox"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition x:Name="CodeToolbarRow" Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border x:Name="AttachmentDraftPanel" Grid.Row="0" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#F1F5FA" CornerRadius="6" Padding="8" Margin="0,0,0,8"><DockPanel LastChildFill="True"><Button x:Name="RemoveAttachmentButton" DockPanel.Dock="Right" Content="移除附件" Click="RemoveAttachmentClick" Margin="8,0,0,0"/><Image x:Name="AttachmentDraftImage" DockPanel.Dock="Left" Width="48" Height="42" Stretch="Uniform" Margin="0,0,8,0"/><TextBlock x:Name="AttachmentDraftText" MaxHeight="44" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.Name="待傳附件"/></DockPanel></Border>
      <TextBox x:Name="Draft" Grid.Row="1" Grid.ColumnSpan="2" AcceptsReturn="True" Height="72" MaxHeight="120" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="4" PreviewKeyDown="DraftPreviewKeyDown" TextChanged="DraftEdited" AutomationProperties.Name="訊息草稿" AllowDrop="True" PreviewDragOver="ComposerDragOver" PreviewDragLeave="ComposerDragLeave" PreviewDrop="ComposerDrop"/>
