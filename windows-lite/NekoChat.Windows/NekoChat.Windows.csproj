<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.1.0-beta.7</Version>
    <FileVersion>0.1.0.7</FileVersion>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../NekoChat.Core/NekoChat.Core.csproj" />
    <ProjectReference Include="../NekoChat.Animation/NekoChat.Animation.csproj" />
    <Content Include="Assets/**" Exclude="Assets/Reactions/*.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets/Reactions/*.png" LogicalName="NekoChat.Windows.Reactions.%(Filename)%(Extension)" />
    <Content Include="../../Examples/CatAppearance/*.json" Link="Coats/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
