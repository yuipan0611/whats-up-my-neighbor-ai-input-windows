<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.1.0-beta.12</Version>
    <FileVersion>0.1.0.12</FileVersion>
    <OutputType>WinExe</OutputType>
    <AssemblyName Condition="'$(DndVerifierAssemblyName)' != ''">$(DndVerifierAssemblyName)</AssemblyName>
    <RootNamespace Condition="'$(DndVerifierAssemblyName)' != ''">NekoChat.Windows</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- CatArtwork and WPF content URIs read built-ins from the extraction base in standalone mode. -->
    <IncludeAllContentForSelfExtract Condition="'$(PublishSingleFile)' == 'true'">true</IncludeAllContentForSelfExtract>
    <NuGetLockFilePath Condition="'$(PublishSingleFile)' == 'true'">packages.singlefile.lock.json</NuGetLockFilePath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../NekoChat.Core/NekoChat.Core.csproj" />
    <ProjectReference Include="../NekoChat.Animation/NekoChat.Animation.csproj" />
    <Content Include="Assets/**" Exclude="Assets/Reactions/*.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets/Reactions/*.png" LogicalName="NekoChat.Windows.Reactions.%(Filename)%(Extension)" />
    <Content Include="../THIRD-PARTY-LICENSES.txt" Link="THIRD-PARTY-LICENSES.txt" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="../THIRD-PARTY-LICENSES.txt" LogicalName="NekoChat.Windows.ThirdPartyLicenses.txt" />
    <Content Include="../../Examples/CatAppearance/*.json" Link="Coats/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup><Compile Include="../../Shared/UpdateDownloadUiFixture.cs" Link="UpdateDownloadUiFixture.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../../Shared/ContactsUiSmokeSeed.cs" Link="Fixtures/ContactsUiSmokeSeed.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../../Shared/TestFixtureFiles.cs" Link="Fixtures/TestFixtureFiles.cs" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../TestFixtures/AttachmentPreview/tiny.*" LogicalName="NekoChat.PreviewFixtures.%(Filename)%(Extension)" />
    <Compile Include="../../Shared/AttachmentPreviewFixtures.cs" Link="Fixtures/AttachmentPreviewFixtures.cs" />
  </ItemGroup>
</Project>
