<Window x:Class="NekoChat.Windows.PetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="208" Height="192" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" Title="NekoChat 桌面貓咪">
 <Canvas x:Name="PetCanvas">
  <Image x:Name="Cat" Width="208" Height="192" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Cursor="Hand" MouseLeftButtonDown="CatDown" MouseMove="CatMove" MouseLeftButtonUp="CatUp" AutomationProperties.Name="桌面貓咪，雙擊左鍵開啟聊天，拖曳移動，右鍵選單"/>
  <Button x:Name="Bubble" Panel.ZIndex="1" Width="280" Visibility="Collapsed" Background="#FFFFFAF5" BorderBrush="#FFD4C7BE" BorderThickness="1" Padding="12" Click="BubbleClick" AutomationProperties.Name="收到的訊息，點擊回覆">
   <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="12"><ContentPresenter/></Border></ControlTemplate></Button.Template>
   <TextBlock x:Name="BubbleText" TextWrapping="Wrap" MaxHeight="82" TextTrimming="CharacterEllipsis" Foreground="#292828"/>
  </Button>
 </Canvas>
</Window>
