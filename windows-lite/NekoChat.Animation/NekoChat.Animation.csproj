<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <TargetFrameworks>net10.0;net48</TargetFrameworks>
  <LangVersion>latest</LangVersion>
  <Nullable>enable</Nullable>
 </PropertyGroup>
 <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
  <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  <Reference Include="System.IO.Compression" />
  <Reference Include="System.IO.Compression.FileSystem" />
  <Reference Include="System.Web.Extensions" />
 </ItemGroup>
 <ItemGroup><EmbeddedResource Include="$(IntermediateOutputPath)cat-animation.zip" LogicalName="NekoChat.Animation.assets.zip"/></ItemGroup>
 <Target Name="PackNativeAnimation" BeforeTargets="PrepareForBuild" Inputs="@(NativeFrame)" Outputs="$(IntermediateOutputPath)cat-animation.zip">
  <MakeDir Directories="$(IntermediateOutputPath)"/>
  <ZipDirectory SourceDirectory="$(MSBuildProjectDirectory)/Assets" DestinationFile="$(IntermediateOutputPath)cat-animation.zip" Overwrite="true"/>
 </Target>
 <ItemGroup><NativeFrame Include="Assets/**"/></ItemGroup>
</Project>
